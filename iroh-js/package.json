  "main": "index.cjs",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "index.cjs",
    "index.d.ts",
    "iroh.darwin-arm64.node",
    "README.md",
    "NOTICE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/natewalton/iroh-ffi.git",
    "directory": "iroh-js"
  },
  "scripts": {
    "build": "bash build-package.sh",
    "test": "node --test test/*.mjs"
  },
  "publishConfig": {
    "access": "public",
    "tag": "experimental"
  },
  "napi": {
    "binaryName": "iroh",
    "targets": [
      "aarch64-apple-darwin"
    ]
